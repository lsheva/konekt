{
  "name": "konekt-ui",
  "version": "0.1.1",
  "description": "Connect and account UI for konekt",
  "license": "ISC",
  "author": "lsheva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsheva/konekt.git",
    "directory": "packages/konekt-ui"
  },
  "homepage": "https://lsheva.github.io/konekt/guides/konekt-ui/",
  "bugs": {
    "url": "https://github.com/lsheva/konekt/issues"
  },
  "keywords": [
    "walletconnect",
    "react",
    "wallet",
    "modal",
    "wagmi",
    "qr",
    "connect-button",
    "web3",
    "dapp",
    "konekt"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wagmi": {
      "types": "./dist/wagmi/index.d.ts",
      "import": "./dist/wagmi/index.js"
    },
    "./wallet-standard": {
      "types": "./dist/wallet-standard/index.d.ts",
      "import": "./dist/wallet-standard/index.js"
    },
    "./cosmos": {
      "types": "./dist/cosmos/index.d.ts",
      "import": "./dist/cosmos/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "wagmi": [
        "./dist/wagmi/index.d.ts"
      ],
      "wallet-standard": [
        "./dist/wallet-standard/index.d.ts"
      ],
      "cosmos": [
        "./dist/cosmos/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "prepack": "pnpm build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "peerDependencies": {
    "konekt": ">=0.2.0",
    "react": ">=19",
    "viem": ">=2",
    "wagmi": ">=3"
  },
  "peerDependenciesMeta": {
    "konekt": {
      "optional": true
    },
    "viem": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    }
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "konekt": "workspace:*",
    "react": "^19.2.8",
    "typescript": "^5.9.2",
    "viem": "^2.55.18",
    "wagmi": "^3.7.6"
  }
}
