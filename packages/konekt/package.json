{
  "name": "konekt",
  "version": "0.1.0",
  "description": "Minimal, modular WalletConnect v2 provider",
  "license": "ISC",
  "author": "lsheva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsheva/konekt.git",
    "directory": "packages/konekt"
  },
  "homepage": "https://lsheva.github.io/konekt/",
  "bugs": {
    "url": "https://github.com/lsheva/konekt/issues"
  },
  "keywords": [
    "walletconnect",
    "ethereum",
    "solana",
    "bitcoin",
    "cosmos",
    "provider"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eip155": {
      "types": "./dist/chains/eip155.d.ts",
      "import": "./dist/chains/eip155.js"
    },
    "./solana": {
      "types": "./dist/chains/solana.d.ts",
      "import": "./dist/chains/solana.js"
    },
    "./bip122": {
      "types": "./dist/chains/bip122.d.ts",
      "import": "./dist/chains/bip122.js"
    },
    "./cosmos": {
      "types": "./dist/chains/cosmos.d.ts",
      "import": "./dist/chains/cosmos.js"
    },
    "./generic": {
      "types": "./dist/chains/generic.d.ts",
      "import": "./dist/chains/generic.js"
    },
    "./siwe": {
      "types": "./dist/features/siwe.d.ts",
      "import": "./dist/features/siwe.js"
    },
    "./cacao": {
      "types": "./dist/features/cacao.d.ts",
      "import": "./dist/features/cacao.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "eip155": [
        "./dist/chains/eip155.d.ts"
      ],
      "solana": [
        "./dist/chains/solana.d.ts"
      ],
      "bip122": [
        "./dist/chains/bip122.d.ts"
      ],
      "cosmos": [
        "./dist/chains/cosmos.d.ts"
      ],
      "generic": [
        "./dist/chains/generic.d.ts"
      ],
      "siwe": [
        "./dist/features/siwe.d.ts"
      ],
      "cacao": [
        "./dist/features/cacao.d.ts"
      ],
      "http": [
        "./dist/http.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "node --env-file-if-exists=../../.env --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "@walletconnect/relay-auth": "1.1.0",
    "@walletconnect/sign-client": "2.23.10",
    "@walletconnect/utils": "2.23.10",
    "hardhat": "^2.26.3",
    "typescript": "^5.9.2",
    "viem": "^2.55.18",
    "ws": "^8.18.3"
  }
}
